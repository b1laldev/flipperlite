# Copy to .env (never commit the real file). Real environment variables win.
FLITE_DEVICE_URL=http://192.168.4.1
FLITE_LISTEN_ADDR=:8080

# Optional bearer token for the REST/SSE bridge. Leave empty for a trusted LAN.
# Generate with: openssl rand -hex 32
FLITE_API_TOKEN=

# CORS origin for web/third-party clients. Use a concrete origin in production.
FLITE_CORS_ORIGIN=*

# Optional provisioning values used by scripts/provision.sh (own network only).
# Prefer real env vars in CI; these are loaded from .env when present.
FLITE_WIFI_SSID=
FLITE_WIFI_PASSWORD=
FLITE_LAUNCH_APP=menu
# FLITE_BRIDGE_URL=http://localhost:8080
# FLITE_AFTER_URL=http://192.168.4.1
