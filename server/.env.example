# Copy to .env (never commit the real file). Real environment variables win.
FLITE_DEVICE_URL=http://192.168.4.1
FLITE_LISTEN_ADDR=:8080

# Optional bearer token for the REST/SSE bridge. Leave empty for a trusted LAN.
# Generate with: openssl rand -hex 32
FLITE_API_TOKEN=

# CORS origin for web/third-party clients. Use a concrete origin in production.
FLITE_CORS_ORIGIN=*
